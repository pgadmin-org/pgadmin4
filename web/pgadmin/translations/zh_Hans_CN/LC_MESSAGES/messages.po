msgstr "EPSG:3857（Web Mercator）"

#: pgadmin/tools/sqleditor/utils/query_tool_preferences.py:922
msgid "EPSG:4326"
msgstr "EPSG:4326"

#: pgadmin/tools/sqleditor/utils/query_tool_preferences.py:923
msgid "EPSG:3395"
msgstr "EPSG:3395"

#: pgadmin/tools/sqleditor/utils/query_tool_preferences.py:928
