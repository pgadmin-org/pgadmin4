#: pgadmin/authenticate/oauth2.py:355
#, python-format
msgid ""
"OAuth2 provider '%(name)s' is configured with 'openid' in OAUTH2_SCOPE "
"but OAUTH2_SERVER_METADATA_URL is not set. pgAdmin needs the provider's "
"OpenID Connect discovery URL to verify the id_token. Either set "
"OAUTH2_SERVER_METADATA_URL to the discovery URL (e.g. https://<issuer"
">/.well-known/openid-configuration), or remove 'openid' from "
"OAUTH2_SCOPE."
msgstr "OAuth2 提供方“%(name)s”在 OAUTH2_SCOPE 中配置了“openid”，但未设置 OAUTH2_SERVER_METADATA_URL。pgAdmin 需要提供方的 OpenID Connect 发现 URL 来验证 id_token。请将 OAUTH2_SERVER_METADATA_URL 设置为发现 URL（例如 https://<issuer>/.well-known/openid-configuration），或从 OAUTH2_SCOPE 中移除“openid”。"

